# Copy this file to .env and fill in real values.
# Firebase web config is not secret, but keep it in env vars for hygiene.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Local server: http://<your-machine-lan-ip>:3000
# Deployed server: https://<your-service>.onrender.com
EXPO_PUBLIC_API_BASE_URL=

# Optional. Only needed if Google Maps misbehaves on Android in Expo Go.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
